# Copy to .env and fill in as needed. Nothing here is read by Step 1 code yet
# (all config lives in conf/*.yaml) -- this is scaffolding for later steps that
# may need a hosted LLM/embedding key (e.g. Step 5's RAG over the PDF corpus).
# Never commit the real .env; it is gitignored.

# Overrides conf/*.yaml's llm.host if you point at a non-default Ollama instance.
OLLAMA_HOST=http://localhost:11434

# Placeholder for a future hosted LLM/embedding provider (Step 5+). Leave blank
# while everything runs locally through Ollama.
# LLM_API_KEY=
